# Copy to .env at the repository root (gitignored) and fill in.
# Read by the Gradle build and scripts/serve-dev-update.sh. Shell environment variables of the same name win.

# LAN updates for debug builds. Your computer's address on the Wi-Fi (macOS: ipconfig getifaddr en0).
# Leave empty to build a debug APK without the LAN updater.
FRAMENOVA_DEV_UPDATE_HOST=192.168.1.20

# Port for scripts/serve-dev-update.sh (default 8767).
FRAMENOVA_DEV_UPDATE_PORT=8767

# Release signing is NOT read from this file. Export these in your shell when needed; passwords are asked for
# when unset:
#   FRAMENOVA_KEYSTORE           default ~/.framenova-signing/framenova-upload.jks
#   FRAMENOVA_KEY_ALIAS          default from scripts/release-settings.sh
#   FRAMENOVA_KEYSTORE_PASSWORD
#   FRAMENOVA_KEY_PASSWORD       defaults to the keystore password
